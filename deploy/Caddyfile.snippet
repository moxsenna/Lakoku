# Append to /opt/wacrm/deploy/Caddyfile then reload Caddy.
# Domain: lakoku.biz.id (+ app.) → reverse_proxy lakoku-web:5200 on wacrm_edge
#
# Audit M-A8 (2026-11-06): asal-IP untuk rate limit dibaca dari
# `cf-connecting-ip` (bila trafik lewat Cloudflare) → `x-real-ip` → hop
# TERAKHIR `x-forwarded-for`. Caddy menimpa XFF klien tak-dipercaya secara
# default; JANGAN set `trusted_proxies` untuk klien publik agar pembaca
# tidak bisa memalsukan XFF untuk melewati rate limit.

lakoku.biz.id, app.lakoku.biz.id {
	encode gzip
	reverse_proxy lakoku-web:5200
}
